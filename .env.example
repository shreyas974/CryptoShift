# QpiAI Opt & QpiAI QCloud Credentials Template (Placeholders Only)
# Copy this file to `.env` in the CryptoShift project root and fill in your keys locally.
# NEVER commit `.env` or `qcloud.env` to Git or paste your API keys into chat.

# 1. QpiAI Opt SDK API Key — register at https://opt.qpiai.tech/
QPIAI_OPT_API_KEY=

# 2. QpiAI QCloud / Quantum SDK API Key — register at https://qcloud.qpiai.tech/
QPIAI_QCLOUD_API_KEY=

# 3. Optional External Real-Dataset Paths (Leave blank to use default local dataset pack path)
CRYPTOSHIFT_DATASET_DIR=
CRYPTOSHIFT_CESNET_H5_PATH=
CRYPTOSHIFT_PQC_OBS_CSV_PATH=

# 3. Sarvam AI (CryptoShift Assistant, optional cloud LLM) - https://dashboard.sarvam.ai/
SARVAM_API_KEY=
