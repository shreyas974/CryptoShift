# QpiAI Quantum SDK (QCloud) Credential File Template
# Copy this file to qcloud.env and replace the placeholder with your real key.
# NEVER commit qcloud.env to version control.
API_KEY="your_qpiai_qcloud_api_key_here"
QPIAI_QCLOUD_API_KEY="your_qpiai_qcloud_api_key_here"
QPIAI_OPT_API_KEY="your_qpiai_opt_api_key_here"

