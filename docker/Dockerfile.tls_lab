FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    openssl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY pyproject.toml requirements.txt requirements-member3.txt ./
RUN pip install --no-cache-dir -r requirements.txt -r requirements-member3.txt

COPY src/ ./src/
COPY demo_bank_app/ ./demo_bank_app/
COPY scripts/ ./scripts/

RUN useradd -m -u 10001 cryptoshift && chown -R cryptoshift:cryptoshift /app
USER cryptoshift

ENV PYTHONPATH=/app/src:/app

CMD ["python", "scripts/member3_phase4.py"]

