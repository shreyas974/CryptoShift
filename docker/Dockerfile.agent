FROM python:3.12-slim

WORKDIR /app

COPY pyproject.toml requirements.txt requirements-member3.txt ./
RUN pip install --no-cache-dir -r requirements.txt -r requirements-member3.txt

COPY src/ ./src/
COPY schemas/ ./schemas/
COPY demo_bank_app/ ./demo_bank_app/
COPY reports/member3/ ./reports/member3/
COPY scripts/ ./scripts/

RUN useradd -m -u 10001 cryptoshift && chown -R cryptoshift:cryptoshift /app
USER cryptoshift

ENV PYTHONPATH=/app/src:/app
ENV CRYPTOSHIFT_AGENT_MODE=template

EXPOSE 8765

CMD ["python", "-m", "uvicorn", "cryptoshift.agent.server:app", "--host", "127.0.0.1", "--port", "8765"]

