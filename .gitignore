# Virtual environments
.venv/
venv/
env/

# Local credentials and secrets (NEVER commit)
.env
.env.local
.env.*
!.env.example
qcloud.env
*.key
*.pem
*.p12
*.pfx

# Local dated backups and scratch artifacts
.backup_*/
scratch/

# Python bytecode, test caches, and build artifacts
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
src/*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage

# Original third-party research snapshots stay local; only filtered, attributed data is tracked
data/public/raw/

# Local dataset path overrides, large HDF5 binaries, and local SQLite state (NEVER commit)
.cryptoshift_datasets.local.json
*.h5
*.hdf5
*.db
*.sqlite
*.sqlite3
