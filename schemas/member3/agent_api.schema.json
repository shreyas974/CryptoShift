{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CryptoShift Assistant API (POST /ask)",
  "type": "object",
  "properties": {
    "request": {
      "type": "object",
      "required": [
        "question"
      ],
      "properties": {
        "question": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "response": {
      "type": "object",
      "required": [
        "answer",
        "citations",
        "tools_used",
        "refused",
        "backend",
        "mode"
      ],
      "properties": {
        "answer": {
          "type": "string"
        },
        "citations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tools_used": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "refused": {
          "type": "boolean"
        },
        "backend": {
          "type": "string"
        },
        "mode": {
          "enum": [
            "SARVAM_CLOUD",
            "TEMPLATE_FALLBACK"
          ]
        },
        "mode_reason": {
          "type": "string"
        },
        "validator": {
          "type": "string"
        },
        "usage": {
          "type": "object",
          "properties": {
            "prompt_tokens": {
              "type": "integer"
            },
            "completion_tokens": {
              "type": "integer"
            }
          }
        }
      }
    }
  },
  "required": [
    "request",
    "response"
  ]
}